{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "⚠ Demo state (P11-fix-002): slice-utilization panels (ascend_npu_slice_util_percent) work once this rebuild lands. Container CPU/memory panels still need cAdvisor (Phase 11+ optional path D). — O-Cloud Edge workload resource view: pod-level CPU / memory and bound NPU-slice utilization. Series pivoted by `$workload`. Slice binding info from `ascend_npu_slice_util_percent{workload=...}` (bound-slice label set by the K8s scheduler at admission). Includes the RFC-003 affinity-vs-non-affinity slice-utilization overlay.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "Pod CPU / Memory",
      "id": 100,
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Pod CPU usage — $workload",
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{workload=~\"$workload\",container!=\"\",container!=\"POD\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{pod}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Pod memory usage — $workload",
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (pod) (container_memory_working_set_bytes{workload=~\"$workload\",container!=\"\",container!=\"POD\"})",
          "refId": "A",
          "legendFormat": "{{pod}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 }
        }
      }
    },
    {
      "type": "row",
      "title": "Bound NPU slice utilization",
      "id": 101,
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Bound slice AICore util — $workload",
      "id": 3,
      "description": "Pulls `ascend_npu_slice_util_percent` filtered by the `workload` label set during slice binding by the DRA-aware scheduler.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 10 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "ascend_npu_slice_util_percent{workload=~\"$workload\"}",
          "refId": "A",
          "legendFormat": "{{node}}/{{npu}}/slice {{slice}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 8 }
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Current slice util — $workload",
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 10 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "ascend_npu_slice_util_percent{workload=~\"$workload\"}",
          "refId": "A",
          "legendFormat": "{{node}}/{{npu}}/{{slice}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      }
    },
    {
      "type": "row",
      "title": "Affinity vs Non-Affinity (RFC-003)",
      "id": 102,
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Affinity vs Non-Affinity — slice util overlay ($workload)",
      "id": 5,
      "description": "RFC-003: overlay slice utilization split by label `affinity=true` (NUMA+HCCS bound) vs `affinity=false`. Used by demo to show co-location impact on resource efficiency.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg by (affinity) (ascend_npu_slice_util_percent{workload=~\"$workload\",affinity=\"true\"})",
          "refId": "A",
          "legendFormat": "avg affinity=true"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg by (affinity) (ascend_npu_slice_util_percent{workload=~\"$workload\",affinity=\"false\"})",
          "refId": "B",
          "legendFormat": "avg affinity=false"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "affinity=true" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "affinity=false" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["o-cloud-edge", "workload", "resource"],
  "templating": {
    "list": [
      {
