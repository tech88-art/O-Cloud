      "title": "Affinity vs Non-Affinity — TTFT p90 overlay ($workload)",
      "id": 6,
      "description": "RFC-003: overlay TTFT p90 split by label `affinity=true` (NUMA+HCCS bound) vs `affinity=false` (no co-location). Used by demo to show scheduling impact.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 27 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.90, sum by (le, affinity) (rate(workload_ttft_ms_bucket{workload=~\"$workload\",affinity=\"true\"}[5m])))",
