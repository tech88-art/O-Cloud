# scheduler-plugin sub-project metadata.
#
# NOT a Kubebuilder file (scheduler-plugin is NOT a Kubebuilder project — it
# IS kube-scheduler with custom plugins linked in via sigs.k8s.io/scheduler-
# plugins framework per ADR-0010 §1). Provided for parity with sibling
# operators sub-projects (pool-operator, npu-dra-driver, inference-operator)
# and to document the module identity at a glance.

projectName: scheduler-plugin
repo: github.com/tech88-art/O-Cloud/operators/scheduler-plugin
domain: ocloud.edge.example.com
phase: 6
status: scaffold

# Plugin registry (filled by T002 placeholder, bodies land T004-T007):
